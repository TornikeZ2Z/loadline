# ---------- Database ----------
# Leave DATABASE_URL unset for local dev: the app runs an embedded Postgres
# (PGlite) persisted in ./.pgdata, so there is nothing to install.
# Point it at real Postgres for staging/production. The schema is plain SQL and
# runs unchanged on Postgres 14+.
# DATABASE_URL=postgres://user:pass@localhost:5432/loadboard

# ---------- Auth ----------
# 32+ random bytes. Sessions are signed with this; changing it logs everyone out.
SESSION_SECRET=dev-only-secret-change-me-to-32-plus-random-bytes

# ---------- Load extraction ----------
# Nothing to configure. Extraction is deterministic rules (src/lib/extract/),
# so it costs nothing to run, needs no network, and produces the same output
# for the same input. Tune it by editing the rules and running `npm run eval`.

# ---------- WhatsApp Cloud API (Meta) ----------
# From Meta App Dashboard -> WhatsApp -> Configuration.
# WHATSAPP_VERIFY_TOKEN is the string you type into the webhook setup form.
# WHATSAPP_APP_SECRET signs the X-Hub-Signature-256 header we verify.
WHATSAPP_VERIFY_TOKEN=dev-verify-token
# WHATSAPP_APP_SECRET=
# Set to 1 to accept unsigned webhook posts (local testing only, never in prod).
WHATSAPP_ALLOW_UNSIGNED=1

# ---------- HERE Location Services ----------
# Powers the location type-ahead, address-level geocoding, and TRUCK road
# distance / drive time on a load. Server-side only -- never exposed to the
# browser. Without it the app falls back to the offline gazetteer and
# straight-line distance, and every screen still works.
# HERE_API_KEY=

# ---------- Geocoding provider ----------
# Defaults to "here" when HERE_API_KEY is set, otherwise "local".
# local   -> offline gazetteer only (no network, no key)
# here    -> HERE Geocoding & Search
# census  -> US Census Bureau geocoder, free and keyless
# mapbox  -> Mapbox Geocoding v6, needs MAPBOX_TOKEN
# GEOCODER=local
# MAPBOX_TOKEN=

# ---------- Timezone ----------
# Relative dates ("tomorrow") are resolved against the sender's local day.
# LOAD_TZ=America/New_York

# ---------- Cron ----------
# Bearer token required by /api/cron/* (expiry sweep, queue drain).
CRON_SECRET=dev-cron-secret
